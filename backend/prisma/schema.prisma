generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model otp_verifications {
  id         Int      @id @default(autoincrement())
  email      String   @db.VarChar(100)
  otp_code   String   @db.VarChar(10)
  expires_at DateTime @db.Timestamp(0)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([email], map: "email_idx")
}

model rfid_cards {
  id              Int                     @id @default(autoincrement())
  card_uid        String                  @unique @db.VarChar(50) 
  card_type       rfid_card_type          @default(Visitor)    
  status          rfid_card_status        @default(Active)     
  created_at      DateTime?               @default(now()) @db.Timestamp(0)
  
  monthly_tickets monthly_tickets[]
  transactions    transactions[]
}

model monthly_tickets {
  id                Int                     @id @default(autoincrement())
  vehicle_id        Int?
  rfid_card_id      Int?                   
  user_id           Int?                 
  plate_number      String?                 @db.VarChar(20) 
  registration_date DateTime?               @default(now()) @db.Timestamp(0)
  expiry_date       DateTime                @db.Date
  price_paid        Decimal?                @db.Decimal(10, 2)
  status            monthly_tickets_status? @default(Active)
  
  vehicles          vehicles?               @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rfid_cards        rfid_cards?             @relation(fields: [rfid_card_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user              users?                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction) 
  @@index([rfid_card_id], map: "rfid_card_id")
  @@index([user_id], map: "user_id_idx")
}

model parking_slots {
  id           Int                   @id @default(autoincrement())
  slot_code    String                @unique(map: "slot_code") @db.VarChar(10) 
  floor        Int?                  @default(1)
  status       parking_slots_status? @default(Available)
  sensor_id    String?               @db.VarChar(50)                   
  updated_at   DateTime?             @default(now()) @db.Timestamp(0)
  transactions transactions[]
}

model roles {
  id        Int     @id @default(autoincrement())
  role_name String  @db.VarChar(50)
  users     users[]
}

model users {
  id              Int               @id @default(autoincrement())
  full_name       String            @db.VarChar(100)
  email           String            @unique(map: "email") @db.VarChar(100)
  password        String            @db.VarChar(255) 
  phone           String?           @db.VarChar(15)
  avatar          String?           @db.LongText
  role_id         Int?
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  
  transactions    transactions[]
  monthly_tickets monthly_tickets[] 
  roles           roles?            @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicles        vehicles[]

  @@index([role_id], map: "role_id")
}

model vehicle_types {
  id              Int        @id @default(autoincrement())
  type_name       String     @db.VarChar(50) 
  base_price      Decimal    @db.Decimal(10, 2)
  overtime_price  Decimal    @db.Decimal(10, 2)
  monthly_price   Decimal    @default(0) @db.Decimal(10, 2)
  vehicles        vehicles[]
}

model vehicles {
  id              Int               @id @default(autoincrement())
  plate_number    String            @unique(map: "plate_number") @db.VarChar(20)
  vehicle_type_id Int?
  user_id         Int?              
  owner_email     String?           @db.VarChar(100) 
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  
  monthly_tickets monthly_tickets[]
  transactions    transactions[]
  vehicle_types   vehicle_types?    @relation(fields: [vehicle_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "user_id")
  @@index([vehicle_type_id], map: "vehicle_type_id")
}

model transactions {
  id             Int                  @id @default(autoincrement())
  vehicle_id     Int?                 
  plate_number   String?              @db.VarChar(20)
  slot_id        Int?
  rfid_card_id   Int?                 
  time_in        DateTime?            @default(now()) @db.Timestamp(0)
  time_out       DateTime?            @db.Timestamp(0)
  image_in_path  String?              @db.LongText    
  image_out_path String?              @db.LongText   
  total_amount   Decimal?             @default(0.00) @db.Decimal(10, 2)
  status         transactions_status? @default(In_Park)
  processed_by   Int?                

  vehicles       vehicles?            @relation(fields: [vehicle_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  parking_slots  parking_slots?       @relation(fields: [slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?               @relation(fields: [processed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rfid_cards     rfid_cards?          @relation(fields: [rfid_card_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([processed_by], map: "processed_by")
  @@index([slot_id], map: "slot_id")
  @@index([vehicle_id], map: "vehicle_id")
  @@index([rfid_card_id], map: "rfid_card_id")
}

enum parking_slots_status {
  Available
  Occupied
  Maintenance
}

enum monthly_tickets_status {
  Active
  Expired
  Pending
}

enum transactions_status {
  In_Park   @map("In-Park")
  Completed
}

enum rfid_card_type {
  Visitor  
  Monthly  
}

enum rfid_card_status {
  Active
  Lost   
  Damaged
}